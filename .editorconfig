# https://editorconfig.org/
root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_length = 120
tab_width = 4
trim_trailing_whitespace = true

[*.{kt,kts}]
ktlint_code_style = android_studio

# Ignore function naming for Composable and Test functions
ktlint_function_naming_ignore_when_annotated_with = Composable, Test

# Disable trailing comma requirement (Android Studio doesn't enforce this by default)
ktlint_standard_trailing-comma-on-call-site = disabled
ktlint_standard_trailing-comma-on-declaration-site = disabled

# Disable multiline expression rules (can conflict with Compose patterns)
ktlint_standard_multiline-expression-wrapping = disabled

# Allow expression body functions on same line
ktlint_standard_function-signature = disabled

# Disable property naming rule (conflicts with common Android patterns)
ktlint_standard_property-naming = disabled

# Disable filename rule (some samples use generic names like Intent.kt)
ktlint_standard_filename = disabled
